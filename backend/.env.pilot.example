# TAXSHIELD PROFESSIONAL v1.2 — PILOT ENVIRONMENT TEMPLATE (.env.pilot.example)
# Copy this file to .env.pilot and supply secure, randomly generated secrets.
# DO NOT commit .env.pilot to version control.

# Database: Dedicated isolated database namespace for 10-Firm Pilot cohort
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tax_shield_pilot

# Cryptographic Token & Authentication Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_HEX_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backup & Integrity Seal (with Key-Rotation Support)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKUP_SEAL_SECRET=REPLACE_WITH_HIGH_ENTROPY_HMAC_SEAL_SECRET
# Optional: comma-separated list of previous HMAC secrets for historical backup verification
# BACKUP_SEAL_PREVIOUS_SECRETS=REPLACE_WITH_HISTORICAL_SECRETS_DURING_ROTATION

# Host & Cross-Origin Resource Sharing
FRONTEND_URL=http://localhost:3000

# Cohort Administration & Audit Access
ADMIN_EMAILS=pilot.admin@taxshield.internal,ca.director@taxshield.internal

# Security Policies & Rate Limiting
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=900
MIN_PASSWORD_LEN=10
MAX_UPLOAD_BYTES=15728640

# Zero-Cost Architecture Policy
ZERO_COST_POLICY=ENFORCED
